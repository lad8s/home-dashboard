# Copy this file to .env for the local preview. On Vercel, set the same two values
# in Project → Settings → Environment Variables. Never commit the real .env.

# Two logins: name:password, separated by a comma. A password must not contain a comma.
USERS=alice:change-me,bob:change-me-too

# Any long random text. Changing it logs everyone out.
SESSION_SECRET=replace-with-32-or-more-random-characters
